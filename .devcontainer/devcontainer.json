
{
  "name": "Prokope Dev Container",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
 
  // Installs deps (including the dev group) into /workspace/.venv on container create,
  // then installs frontend npm dependencies
  "postCreateCommand": "bash .devcontainer/../backend/scripts/post-create.sh; (cd frontend && npm install)",
 
  "remoteEnv": {
    "DATABASE_URL": "postgres://user:password@db:5432/test_db"
  },
 
  "forwardPorts": [8000, 5173, 5432],
  "portsAttributes": {
    "8000": { "label": "Django dev server" },
    "5173": { "label": "Frontend (Vite dev server)" },
    "5432": { "label": "Postgres test DB" }
  },
 
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "batisteo.vscode-django",
        "firefox-devtools.vscode-firefox-debug"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.testing.pytestEnabled": true
      }
    }
  },
  "features": {
    "ghcr.io/danzilberdan/devcontainers/opencode:0": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "mounts": [
    {
      "source": "${localWorkspaceFolder}/.opencode/auth.json",
      "target": "/mnt/opencode-auth.json",
      "type": "bind"
    }
  ]
}
 