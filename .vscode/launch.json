{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run server (QA mode, no args)",
      "type": "node-terminal",
      "request": "launch",
      "command": "${workspaceFolder}/backend/scripts/runserver.sh",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run server (--debug)",
      "type": "node-terminal",
      "request": "launch",
      "command": "${workspaceFolder}/backend/scripts/runserver.sh --debug",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run server (--test)",
      "type": "node-terminal",
      "request": "launch",
      "command": "${workspaceFolder}/backend/scripts/runserver.sh --test",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: Attach to Django (debugpy)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "justMyCode": true,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "."
        }
      ]
    },
    {
      "name": "Frontend: Debug (Vite + Firefox)",
      "type": "firefox",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "reAttach": true,
      "preLaunchTask": "npm: dev (frontend)",
      "serverReadyAction": {
        "pattern": "Local:\\s+http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}